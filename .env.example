DJANGO_SETTINGS_MODULE=config.development
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=
# Set DB_HOST=localhost to use PostgreSQL in development; otherwise SQLite.
DB_PORT=5432
DB_SSLMODE=require
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=https://events.example.com
CORS_ALLOWED_ORIGINS=
NUM_PROXIES=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EventHub <noreply@example.com>
MEDIA_ROOT=/app/media
